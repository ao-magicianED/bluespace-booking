# ===== Supabase（DB）サーバー専用 =====
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ===== Stripe（決済）=====
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ===== Google Calendar（サービスアカウント）=====
# GCPでダウンロードしたサービスアカウントのJSONキーを丸ごとBase64にした文字列
# PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=

# ===== メール通知（Resend / 未設定ならメール送信をスキップ）=====
RESEND_API_KEY=
MAIL_FROM=ブルーステージ予約 <noreply@bluestage-lcc.com>
ADMIN_EMAIL=info@bluestage-lcc.com

# ===== サイト =====
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===== Google Search Console（metaタグ認証）=====
# Search Console → プロパティ追加 → HTMLタグ → content="..." の値を貼る
GOOGLE_SITE_VERIFICATION=

# ===== Google Analytics 4（未設定なら本番測定IDにフォールバック。src/lib/gtag.ts参照）=====
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ===== Cron保護（ランダムな長い文字列を設定）=====
CRON_SECRET=

# --- Google Ads API（オフラインコンバージョン送信）---
# 開発者トークンは「管理者アカウント(MCC)」のAPI Centerでのみ発行できる。
# 審査(Basic Access)が下りるまでは未設定でよい。その間はCSV手動アップロードで代替される。
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# MCC経由で子アカウントを操作する場合のみ設定（ハイフンなし）
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# コンバージョンアクションの数値ID（Google広告の管理画面で確認）
GOOGLE_ADS_CONVERSION_ACTION_ID=
# CSVアップロード時に使う表示名。管理画面で作った名前と完全一致させる
GOOGLE_ADS_CONVERSION_ACTION_NAME=
# APIバージョン。未設定なら v25。
# 各バージョンは約1年で完全終了し、終了後は全リクエストが失敗する。
# 終了予定は https://developers.google.com/google-ads/api/docs/sunset-dates で確認し、
# 切り替えはこの環境変数だけで済ませる（デプロイ不要）
GOOGLE_ADS_API_VERSION=
